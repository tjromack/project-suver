# Copy to .env and fill in. Never commit .env.
# Provider for the DRAFTING step only (candidate key-points): "stub" (deterministic, offline) | "anthropic".
# Sanitize, split, and grounding are ALWAYS deterministic and never call a model.
PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Max upload size (bytes) for a dropped document.
MAX_DOC_BYTES=5000000
# PYTHONUTF8=1 recommended on Windows for Unicode.
