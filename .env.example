# Copy to .env and fill in. Never commit .env.
# Provider for the DRAFTING step only (candidate key-points): "stub" (deterministic, offline) | "anthropic".
# Sanitize, split, and grounding are ALWAYS deterministic and never call a model.
PROVIDER=anthropic   # the real product; set PROVIDER=stub to run fully offline (no key, extractive)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Max upload size (bytes) for a dropped document.
MAX_DOC_BYTES=20000000
# Chars sent to the drafting model (long docs -> leading portion, with a note).
MAX_DRAFT_CHARS=40000
# Retrieval quality (DEC 040) — LLM re-ranking: after lexical retrieval pulls a wider candidate pool, the model
# re-orders those (already-sanitized) passages so the ones that actually answer the question land in the top-K.
# Opt-in (adds one model call per question); the grounding gate is untouched. Off by default.
# RETRIEVAL_RERANK=1
# RETRIEVAL_RERANK_POOL=12
# PYTHONUTF8=1 recommended on Windows for Unicode.
